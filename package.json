{
  "name": "monitor-ptap",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=26.12.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run dev:api",
    "dev:mobile": "npm run start -w @ptap/mobile",
    "dev:api": "npm run start:dev -w @ptap/api",
    "dev:sim": "npm run dev:sim -w @ptap/api --",
    "build": "npm run build -w @ptap/shared && npm run build -w @ptap/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "web": "npm run web -w @ptap/mobile"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true,
    "@firebase/util@1.15.3": true
  }
}
